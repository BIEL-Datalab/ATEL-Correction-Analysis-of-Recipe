   ],
   "source": [
    "# ============================================================\n",
    "# 全局配置：定位列 / 输出路径 / 分析目标分组 / 异常阈值\n",
    "# ============================================================\n",
    "import os\n",
    "import warnings\n",
    "from datetime import datetime\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# 异常记录附带的定位列（贯穿后续所有 cell）\n",
    "LOCATOR_COLS = ['id', 'machine_sn', 'batch_log', 'hc_chamber_day']\n",
    "\n",
    "# 输出根目录：results/research/raw_data_eda/\n",
    "OUTPUT_BASE_DIR = '/home_ext/zzx/work_file/ATEL-Correction-Analysis-of-Recipe/results/research/raw_data_eda'\n",
    "\n",
    "# 运行日期子文件夹：每次 EDA 运行单独一个目录，区分不同时间的分析结果\n",
    "# 格式 run_YYYYMMDD_HHMMSS（含时分秒，避免同一天多次运行互相覆盖）\n",
    "RUN_SUBDIR = f\"run_{datetime.now().strftime('%Y%m%d_%H%M%S')}\"\n",
    "OUTPUT_DIR = os.path.join(OUTPUT_BASE_DIR, RUN_SUBDIR)\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "# 异常数据汇总 xlsx（结构/越界/离群，不同 sheet，整条原始行）\n",
    "ANOMALY_XLSX = os.path.join(OUTPUT_DIR, 'raw_data_anomalies.xlsx')\n",
    "# EDA 概述 xlsx（每张表一个 sheet，列对齐清晰，替代原 txt）\n",
    "SUMMARY_XLSX = os.path.join(OUTPUT_DIR, 'raw_data_eda_summary.xlsx')\n",
    "# 组合唯一值 + 字段唯一值 xlsx\n",
    "COMBO_XLSX = os.path.join(OUTPUT_DIR, 'raw_data_combo_uniques.xlsx')\n",
    "\n",
    "# IQR 离群倍数\n",
    "IQR_OUTLIER_K = 5\n",
    "\n",
    "# Y 物理越界阈值\n",
    "COLOR_AB_ABS_MAX = 100          # 颜色 a/b 绝对值上限（CIE Lab 理论 [-128,128]，取宽松 200）\n",
    "TRANSMISSION_VALID_RANGE = (0.0, 100.0)  # 透过率有效区间 (0, 100]\n",
    "\n",
    "# 分布+离群分析的目标分组：M_cathode / incoming_quality / 所有 Y 指标（除 variance）\n",
    "DIST_GROUPS = ['M_cathode', 'incoming_quality']\n",
    "Y_GROUPS = [\n",
    "    'Y_color_c3_10', 'Y_color_c3_45',\n",
    "    'Y_transmission_t0_940', 'Y_transmission_t40_920_960', 'Y_transmission_t0_400_770',\n",
    "]\n",
    "\n",
    "# 所有 Y 指标列（剔除 variance 变量）—— 分布/离群/越界的统一目标\n",
    "Y_value_cols = [c for g in Y_GROUPS for c in col_groups[g] if 'variance' not in c]\n",
    "\n",
    "# 组合唯一值分析目标\n",
    "COMBO_DEFS = [\n",
    "    ('machine_sn+S_actual_rate', ['machine_sn'] + col_groups['S_actual_rate']),\n",
    "    ('machine_sn+S_set_rate', ['machine_sn'] + col_groups['S_set_rate']),\n",
    "    ('machine_sn+S_rate_coefficient', ['machine_sn'] + col_groups['S_rate_coefficient']),\n",
    "    ('ftu_operation+ftu_type', ['ftu_operation', 'ftu_type']),\n",
    "]\n",
    "\n",
    "# ---- 单字段唯一值分析的字段范围 ----\n",
    "# 不纳入单字段唯一值的：identifier 整组、service_order 单列\n",
    "UNIQUE_EXCLUDE_GROUPS = {'identifier'}\n",
    "UNIQUE_EXCLUDE_COLS = {'service_order'}\n",
    "# 额外纳入单字段唯一值的分组（虽为数值计数型，但低基数，适合列唯一值）：test_info\n",
    "UNIQUE_EXTRA_GROUPS = ['test_info']\n",
    "\n",
    "print('输出根目录:', OUTPUT_BASE_DIR)\n",
    "print('本次运行子目录:', RUN_SUBDIR)\n",
    "print('实际输出目录:', OUTPUT_DIR)\n",
    "print('分布+离群目标分组:', DIST_GROUPS)\n",
    "print('Y 指标列(除variance)数:', len(Y_value_cols))\n",
    "print('组合唯一值分析:', [name for name, _ in COMBO_DEFS])\n",
    "print('单字段唯一值排除组:', UNIQUE_EXCLUDE_GROUPS, '排除列:', UNIQUE_EXCLUDE_COLS, '额外组:', UNIQUE_EXTRA_GROUPS)"
   ]
  },
