   "source": [
    "# ============================================================\n",
    "# 4. 组合唯一值 + 单字段唯一值\n",
    "#    组合：4 个组合，每个给出\"唯一取值内容(带频次) + 唯一个数\"\n",
    "#    单字段：不在组合内的字段，剔除 identifier 组与 service_order，纳入 test_info 组\n",
    "#            每个字段给出\"唯一取值内容(带频次) + 唯一个数\"\n",
    "# ============================================================\n",
    "\n",
    "combo_results: dict[str, pd.DataFrame] = {}\n",
    "combo_counts: dict[str, int] = {}\n",
    "\n",
    "# -------------------- 4.1 四个组合的唯一值内容 + 个数 --------------------\n",
    "for name, cols in COMBO_DEFS:\n",
    "    # dropna=False 保留缺失作为独立取值\n",
    "    vc = df.groupby(cols, dropna=False).size().reset_index(name='出现次数').sort_values('出现次数', ascending=False)\n",
    "    combo_results[name] = vc\n",
    "    combo_counts[name] = len(vc)\n",
    "\n",
    "# -------------------- 4.2 单字段唯一值 --------------------\n",
    "# 组合内已覆盖的字段：machine_sn, S 三组, ftu_operation, ftu_type\n",
    "combo_covered_cols = set()\n",
    "for _, cols in COMBO_DEFS:\n",
    "    combo_covered_cols.update(cols)\n",
    "\n",
    "# 单字段唯一值的字段范围：\n",
    "#   - 排除组合已覆盖字段\n",
    "#   - 排除 identifier 整组（id/machine_sn/batch_log/batch_log_tag/hc_chamber_day/time_index）\n",
    "#   - 排除 service_order\n",
    "#   - 纳入 test_info 组（虽为数值计数型，但低基数，适合列唯一值）\n",
    "#   - 其余仅取 object 类型（避免连续数值列 dumping 大量无意义唯一值）\n",
    "identifier_cols = set(col_groups['identifier'])\n",
    "test_info_cols = set(col_groups['test_info'])\n",
    "\n",
    "single_field_cols = [\n",
    "    c for c in df.columns\n",
    "    if c not in combo_covered_cols\n",
    "    and c not in identifier_cols\n",
    "    and c != 'service_order'\n",
    "    and (df[c].dtype == 'object' or c in test_info_cols)\n",
    "]\n",
    "\n",
    "single_field_results: dict[str, pd.DataFrame] = {}\n",
    "single_field_counts: dict[str, int] = {}\n",
    "for col in single_field_cols:\n",
    "    vc = df[col].value_counts(dropna=False).reset_index()\n",
    "    vc.columns = ['取值', '出现次数']\n",
    "    vc = vc.sort_values('出现次数', ascending=False)\n",
    "    single_field_results[col] = vc\n",
    "    single_field_counts[col] = len(vc)\n",
    "\n",
    "# -------------------- 输出概况 --------------------\n",
    "print('=' * 60)\n",
    "print('  组合唯一值概况')\n",
    "print('=' * 60)\n",
    "for name in [n for n, _ in COMBO_DEFS]:\n",
    "    print(f'[{name}]  唯一组合数 = {combo_counts[name]}')\n",
    "    print(combo_results[name].head(8).to_string(index=False))\n",
    "    print()\n",
    "\n",
    "print('=' * 60)\n",
    "print('  单字段唯一值概况（排除 identifier 组、service_order；纳入 test_info 组）')\n",
    "print('=' * 60)\n",
    "print(f'字段数: {len(single_field_cols)}')\n",
    "print('字段:', single_field_cols)\n",
    "for col in single_field_cols:\n",
    "    print(f'\\n[{col}]  nunique = {single_field_counts[col]}')\n",
    "    print(single_field_results[col].head(10).to_string(index=False))"
   ]
  },
