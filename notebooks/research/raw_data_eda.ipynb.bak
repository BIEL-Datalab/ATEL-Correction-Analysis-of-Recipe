   "id": "a1b2c3d4",
   "metadata": {},
   "source": [
    "# 原始数据探索分析\n",
    "\n",
    "数据源：`raw_data/raw_data_260623/data.parquet`（282 列，49799 行）\n",
    "\n",
    "## 载入策略\n",
    "- **不读入** `M_o2`(8 列)、`M_ar`(120 列)（量大、属传感器原始监控量，本期不分析）。\n",
    "- 读入时将 `S_actual_rate`/`S_set_rate`/`S_rate_coefficient` 三组（object 存数字字符串）转为数值列。\n",
    "\n",
    "## 分析内容\n",
    "1. **结构异常**：S 整批缺失、Y 颜色全缺、Y 透过率全缺、主键重复（不做 time_index 单调性、不做 object 实为数值检测）。\n",
    "2. **Y 物理越界**：颜色 a/b `|val|>200`、透过率越出 (0,100]（均不含 variance）。\n",
    "3. **分布 + IQR×5 离群**：仅针对 `M_cathode`、`incoming_quality`、所有 Y 指标（除 variance 变量）。\n",
    "4. **唯一值**：\n",
    "   - 4 个组合的唯一取值内容+个数。\n",
    "   - 单字段唯一值：剔除 identifier 组与 service_order，纳入 test_info 组；每个字段给出唯一取值内容+个数。\n",
    "\n",
    "## 输出（`results/research/raw_data_eda/run_YYYYMMDD_HHMMSS/`）\n",
    "- 每次运行在 `raw_data_eda/` 下创建一个带运行时间戳的子目录，区分不同时间的 EDA 分析结果。\n",
    "- 子目录内三个文件：\n",
    "  - `raw_data_anomalies.xlsx`：异常数据（结构/越界/离群，均存**整条原始行**），不同异常不同 sheet。\n",
    "  - `raw_data_eda_summary.xlsx`：EDA 概述，每张表一个 sheet（结构/越界/分布/离群/组合/单字段），列对齐清晰。\n",
    "  - `raw_data_combo_uniques.xlsx`：组合唯一值 + 单字段唯一值，每项一个 sheet。\n",
    "- 异常仅定位不清洗。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "b1c2d3e4",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-06-26T03:03:48.398651Z",
     "iopub.status.busy": "2026-06-26T03:03:48.398416Z",
     "iopub.status.idle": "2026-06-26T03:03:49.571790Z",
     "shell.execute_reply": "2026-06-26T03:03:49.570490Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "原始总列数: 284\n",
      "排除 M_o2 (8 列) + M_ar (120 列)\n",
      "实际加载列数: 156\n",
      "\n",
      "df shape: (49799, 156)\n",
      "已将 S 三组 33 列转为数值类型（当前 dtype: float64）\n",
      "<class 'pandas.core.frame.DataFrame'>\n",
      "RangeIndex: 49799 entries, 0 to 49798\n",
      "Columns: 156 entries, id to end_time\n",
      "dtypes: float64(126), int64(6), object(24)\n",
      "memory usage: 59.3+ MB\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import pyarrow.parquet as pq\n",
    "\n",
    "DATA_PATH = '/home_ext/zzx/work_file/ATEL-Correction-Analysis-of-Recipe/raw_data/raw_data_260623/data.parquet'\n",
    "\n",
    "# ============================================================\n",
    "# 1. 先读 schema（仅读列名，不载入数据），用于按分类计算需要加载的列\n",
    "# ============================================================\n",
    "_all_columns = pq.ParquetFile(DATA_PATH).schema.names\n",
    "\n",
    "\n",
    "def classify_columns(columns) -> dict[str, list[str]]:\n",
    "    \"\"\"按命名规律将列分到各业务类别，未匹配的归入 other。\n",
    "\n",
    "    基于列名做分类，不依赖具体数据，可在只读 schema 时调用。\n",
    "    \"\"\"\n",
    "    cols = list(columns)\n",
    "    groups = {\n",
    "        # ---------- 标识 / 时间索引 ----------\n",
    "        'identifier': [\n",
    "            'id', 'machine_sn', 'batch_log', 'batch_log_tag',\n",
    "            'hc_chamber_day', 'time_index',\n",
    "        ],\n",
    "        # ---------- S: 设定参数（可调控） ----------\n",
    "        # actual_rate 为实际下发的速率，归入 S 设定类（与 set_rate 配套使用）\n",
    "        'S_actual_rate': [c for c in cols if c.startswith('actual_rate_l')],\n",
    "        'S_set_rate': [c for c in cols if c.startswith('set_rate_l')],\n",
    "        'S_rate_coefficient': [c for c in cols if c.startswith('rate_coefficient_l')],\n",
    "        # ---------- M: 监控参数（传感器实际值） ----------\n",
    "        'M_o2': [c for c in cols if c.startswith('o2_')],\n",
    "        'M_ar': [c for c in cols if c.startswith('ar') and '_l' in c],\n",
    "        'M_cathode': [c for c in cols if c.startswith('cathode') and c.endswith('_usevalue')],\n",
    "        # ---------- 产品规格 / 上下文 ----------\n",
    "        'product_spec': [\n",
    "            'l_length', 'width', 'area', 'floor_number',\n",
    "            'inside_code', 'pcs_qty', 'batch_production_duration',\n",
    "            'parameter_production_count',\n",
    "        ],\n",
    "        # ---------- 上游来料质量 ----------\n",
    "        'incoming_quality': [c for c in cols if c.startswith('incoming_')],\n",
    "        # ---------- Y: 质检结果（输出指标统计量） ----------\n",
    "        'Y_color_c3_10': [c for c in cols if c.startswith('c3_10_')],\n",
    "        'Y_color_c3_45': [c for c in cols if c.startswith('c3_45_')],\n",
    "        'Y_transmission_t0_940': [c for c in cols if c.startswith('t_0deg_940_')],\n",
    "        'Y_transmission_t40_920_960': [c for c in cols if c.startswith('t_40deg_920_960_')],\n",
    "        'Y_transmission_t0_400_770': [c for c in cols if c.startswith('t_0deg_400_770_')],\n",
    "        # ---------- 设备 / 维保 ----------\n",
    "        'equipment_maintenance': [\n",
    "            'service_type', 'service_order', 'malfunction_type_code',\n",
    "            'ftu_operation', 'ftu_type', 'deposition_time', 'pumping_time',\n",
    "            'pass_status', 'fail_detail', 'color_station', 'tr_station',\n",
    "        ],\n",
    "        # ---------- 测试相关 ----------\n",
    "        'test_info': ['c3_test_pcs_qty', 't_test_pcs_qty', 'test_pcs_qty'],\n",
    "    }\n",
    "    classified = set(col for cols_ in groups.values() for col in cols_)\n",
    "    unclassified = [c for c in cols if c not in classified]\n",
    "    if unclassified:\n",
    "        groups['other'] = unclassified\n",
    "    return groups\n",
    "\n",
    "\n",
    "# 基于列名分类（此时只读了 schema，尚未载入数据）\n",
    "col_groups = classify_columns(_all_columns)\n",
    "\n",
    "# ============================================================\n",
    "# 2. 计算需要加载的列：排除 M_o2 / M_ar（不读入、不分析）\n",
    "# ============================================================\n",
    "EXCLUDE_GROUPS = {'M_o2', 'M_ar'}\n",
    "load_cols: list[str] = []\n",
    "for g, cols in col_groups.items():\n",
    "    if g in EXCLUDE_GROUPS:\n",
    "        continue\n",
    "    load_cols.extend(cols)\n",
    "load_cols = list(dict.fromkeys(load_cols))  # 去重保序\n",
    "\n",
    "print(f'原始总列数: {len(_all_columns)}')\n",
    "print(f'排除 M_o2 ({len(col_groups[\"M_o2\"])} 列) + M_ar ({len(col_groups[\"M_ar\"])} 列)')\n",
    "print(f'实际加载列数: {len(load_cols)}')\n",
    "\n",
    "# ============================================================\n",
    "# 3. 仅加载需要的列\n",
    "# ============================================================\n",
    "df = pd.read_parquet(DATA_PATH, columns=load_cols)\n",
    "print(f'\\ndf shape: {df.shape}')\n",
    "\n",
    "# ============================================================\n",
    "# 4. S 三组（object 存数字字符串）转数值列\n",
    "# ============================================================\n",
    "S_NUMERIC_GROUPS = ['S_actual_rate', 'S_set_rate', 'S_rate_coefficient']\n",
    "S_numeric_cols = [c for g in S_NUMERIC_GROUPS for c in col_groups[g]]\n",
    "for c in S_numeric_cols:\n",
    "    df[c] = pd.to_numeric(df[c], errors='coerce')\n",
    "print(f'已将 S 三组 {len(S_numeric_cols)} 列转为数值类型（当前 dtype: {df[S_numeric_cols[0]].dtype}）')\n",
    "\n",
    "# 重新基于实际加载的 df 计算 col_groups（去掉 M_o2/M_ar 相关空分组）\n",
    "col_groups = classify_columns(df.columns)\n",
    "df.info(max_cols=0)"
   ]
  },
  {
